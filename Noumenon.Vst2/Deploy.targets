<Project>

  <!-- VST.NET's DeployVstNet target (from the package) runs "vstnet publish" after every build and
       writes the folder a host loads to $(OutDir)deploy: the native bridge renamed to
       <AssemblyName>.dll, this assembly as <AssemblyName>.net.vst2, every dependency and the
       runtimeconfig. These two targets complete that folder. Both identity projects import this. -->

  <!-- Debug builds carry the symbols so breakpoints bind when a host loads from deploy. -->
  <Target Name="CopyPdbsToDeploy" AfterTargets="DeployVstNet" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <_DeployPdb Include="$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployPdb)" DestinationFolder="$(OutDir)deploy" SkipUnchangedFiles="true" />
  </Target>

  <!-- The factory content rides along as deploy\content, so a portable copy of the folder carries
       its presets and samples. The copy is a mirror: a file that left content\ (a preset moved
       into a family folder) is deleted from deploy\content too, or it would ship twice. -->
  <Target Name="CopyContentToDeploy" AfterTargets="DeployVstNet">
    <ItemGroup>
      <_FactoryContent Include="$(MSBuildThisFileDirectory)..\content\**\*" />
      <_DeployedContent Include="$(OutDir)deploy\content\**\*" />
      <_StaleContent Include="@(_DeployedContent)" Exclude="@(_FactoryContent->'$(OutDir)deploy\content\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_StaleContent)" />
    <Copy SourceFiles="@(_FactoryContent)" DestinationFiles="@(_FactoryContent->'$(OutDir)deploy\content\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
